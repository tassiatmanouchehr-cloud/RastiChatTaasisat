# Production environment template.
#
# Copy to `.env.production` on the VPS (chmod 600, outside version control)
# and fill in real values. Structurally identical to .env.staging.example —
# production and staging share the exact same security posture in
# settings.py (ENVIRONMENT in {staging, production} both mean "real,
# internet-facing HTTPS deployment") — only the domains and secrets differ.
# Every domain below is an EXAMPLE; nothing in the app or Nginx templates
# hardcodes them. See docs/runbooks/STAGING_DEPLOYMENT.md (the same
# procedure applies, pointed at production domains/secrets) and
# docs/runbooks/ENVIRONMENT_VARIABLES.md.
#
# Generate DJANGO_SECRET_KEY and DB/REDIS passwords with:
#   scripts/generate-secrets.sh
# Use FRESH secrets — never reuse a staging secret in production.

# --- Django ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_scripts_generate-secrets.sh
DJANGO_SETTINGS_MODULE=config.settings

ALLOWED_HOSTS=chat.rastisi.ir,operator-chat.rastisi.ir,platform-chat.rastisi.ir
CSRF_TRUSTED_ORIGINS=https://operator-chat.rastisi.ir,https://platform-chat.rastisi.ir
CORS_ALLOWED_ORIGINS=https://operator-chat.rastisi.ir,https://platform-chat.rastisi.ir,https://chat.rastisi.ir,https://REPLACE_WITH_RASTISI_STOREFRONT_DOMAIN

TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
# ADMIN_URL=admin/

# --- Database (Postgres, private network only — never expose 5432) -------
DATABASE_URL=postgres://rastichat:REPLACE_WITH_GENERATED_PASSWORD@db:5432/rastichat_db
DB_CONN_MAX_AGE=60

# --- Redis (Channels/WebSocket layer, private network only) --------------
REDIS_URL=redis://redis:6379/0

# --- Media / static --------------------------------------------------------
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# --- Upload limits ----------------------------------------------------------
MEDIA_UPLOAD_MAX_IMAGE_BYTES=8388608
MEDIA_UPLOAD_MAX_VOICE_BYTES=15728640
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520

# --- Rate limiting -----------------------------------------------------------
LOGIN_THROTTLE_RATE=10/min
WIDGET_START_THROTTLE_RATE=20/min
WIDGET_MESSAGE_THROTTLE_RATE=60/min
WIDGET_RATING_THROTTLE_RATE=20/min
KB_FEEDBACK_THROTTLE_RATE=20/min
KB_SEARCH_THROTTLE_RATE=60/min
MACRO_EXECUTION_THROTTLE_RATE=60/min
MEDIA_UPLOAD_THROTTLE_RATE=30/min
WIDGET_WS_MESSAGE_RATE_LIMIT=30
WIDGET_WS_MESSAGE_RATE_WINDOW_SECONDS=60

# --- Security headers -------------------------------------------------------
SECURE_HSTS_SECONDS=31536000
# Only flip this on once EVERY subdomain under this domain is permanently
# HTTPS-only and you understand preload-list removal takes months:
# SECURE_HSTS_PRELOAD=1

# --- Frontend build-time URLs (baked in at image build time) ---------------
NEXT_PUBLIC_API_BASE_URL=https://chat.rastisi.ir/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://chat.rastisi.ir/ws

# --- Backup -----------------------------------------------------------------
BACKUP_DIR=/opt/rastichat/backups
BACKUP_RETENTION_DAYS=30
